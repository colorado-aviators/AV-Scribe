{
  "name": "av-scribe",
  "description": "A web app that makes it easier to transcribe aviation weather data accessed over the radio",
  "author": "McGregor Joyner",
  "version": "0.7.1",
  "homepage": "https://coloradoaviators.net/AV-Scribe",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "mathjs": "15.1.1",
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^28.0.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colorado-aviators/AV-Scribe"
  },
  "directories": {
    "lib": "src/lib"
  }
